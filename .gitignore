# Imaging data never goes to GitHub (dataset licences + volunteer consent).
# Only small JSON metadata under data/ is committed.
data/**
!data/**/
!data/**/*.json
# Backups before every write (they hold lut.json copies, which the line above would let in)
data/*/backups/
# Raw model predictions from tools/autolabels.py
data/*/auto/

# Belt and braces: no imaging files anywhere in the repo
*.nii
*.nii.gz
*.dcm
*.mgz
*.nrrd

# Python
__pycache__/
*.pyc
.venv/
# Model venv for tools/autolabels.py (requirements-autoseg.txt)
venv-autoseg/

# Generated locally (regenerate with tools/make_demo_case.py / build_case.py)
data/index.json
data/demo-*/
# Mirrored copy (rebuilt by tools/mirror_case.py) and temporary OAIZIB-CM candidates
data/knee-mri-left/
data/cand-*/

# Brainstorm mockups and plan workspaces
.superpowers/
